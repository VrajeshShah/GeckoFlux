{
  "manifest_version": 2,
  "name": "Native Speed Controller Bridge",
  "version": "1.0.0",
  "description": "Bridges native Android speed controls with HTML5 video elements",
  "browser_specific_settings": {
    "gecko": {
      "id": "speed_bridge@geckoflux.com",
      "strict_min_version": "57.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*",
        "*://*.youtu.be/*"
      ],
      "js": ["speed_bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
