<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/youtube_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- Top Drag Handle -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="@color/youtube_text_secondary" />

    <!-- Header Row (Title, Current Speed Badge, Reset, Close) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_speed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/speed_controller_title"
            android:textColor="@color/youtube_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_current_speed_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/tv_speed_title"
            android:background="@drawable/ic_speed_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="1.00x"
            android:textColor="@color/youtube_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Reset Button -->
        <ImageButton
            android:id="@+id/btn_reset_speed"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btn_close_sheet"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/speed_reset"
            android:src="@drawable/ic_refresh"
            app:tint="@color/youtube_text_secondary" />

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btn_close_sheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/youtube_text_secondary" />
    </RelativeLayout>

    <!-- Quick Preset Chips Scrollable Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Presets"
        android:textColor="@color/youtube_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_presets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_025"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.25x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_05"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.5x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_075"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.75x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_10"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x (Normal)"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_125"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.25x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_15"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_175"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.75x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_20"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.0x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_25"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.5x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_30"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.0x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_40"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.0x"
                android:textColor="@color/youtube_white"
                app:chipBackgroundColor="@color/youtube_chip_bg" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Continuous Precision Slider -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Fine Tuning (0.05x steps)"
            android:textColor="@color/youtube_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_slider_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="1.00x"
            android:textColor="@color/youtube_white"
            android:textSize="12sp" />
    </RelativeLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="0.05"
        android:value="1.00"
        android:valueFrom="0.25"
        android:valueTo="4.00"
        app:thumbColor="@color/youtube_red"
        app:trackColorActive="@color/youtube_red"
        app:trackColorInactive="@color/youtube_chip_bg" />

    <!-- Min/Max Range Labels -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="0.25x"
            android:textColor="@color/youtube_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="4.00x"
            android:textColor="@color/youtube_text_secondary"
            android:textSize="11sp" />
    </RelativeLayout>

</LinearLayout>
